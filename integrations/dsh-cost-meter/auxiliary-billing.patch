+import assert from 'node:assert/strict'
+import {mkdtempSync,readFileSync,writeFileSync,rmSync} from 'node:fs'
+import {tmpdir} from 'node:os'
+import {join} from 'node:path'
+import {randomUUID} from 'node:crypto'
+import {Ledger,sanitizeConfig,localDayKey} from '../lib/store.js'
+import {createAuxiliaryBilling,auxiliaryRecordsFor,auxiliarySourcePath,isAuxiliaryEvent,withAuxiliaryBilling,isAuxiliaryBilling} from '../lib/auxiliary-usage.js'
+import {createLlmStreamBilling} from '../lib/billing-stream.js'
+import {replaySessionRecords} from '../lib/backfill.js'
+import {turnCostFromRecords} from '../lib/turn-cost.js'
+const root=mkdtempSync(join(tmpdir(),'cm-jev-'))
+const at=Date.now()-20000,sessionId='auxiliary-session',path=join(root,'ledger.json')
+const config=sanitizeConfig({peakEnabled:false,exchangeRateAuto:false,legacyAutoImportedAt:1})
+const usage={inputTokens:1000,outputTokens:100,cacheReadTokens:200,cacheWriteTokens:0,reasoningTokens:0}
+const base=()=>({protocol:1,requestId:randomUUID(),pluginId:'dsh-jev-progress',kind:'jev-summary',sessionId,provider:'deepseek-official',model:'deepseek-flash',startedAtMs:at,elapsedMs:12,outcome:'ok',usage,turn:2,step:3,pricing:{kind:'catalog'}})
+const near=(a,b)=>assert.ok(Math.abs(a-b)<1e-12,`${a} != ${b}`)
+try {
+ const ledger=new Ledger(config,{},path),billing=createAuxiliaryBilling(ledger)
+ const record=base(),free={...base(),provider:'jev',model:'vllm-sr/d3-turbo',kind:'jev-decision',usage:{...usage,outputTokens:0},pricing:{kind:'free',source:'https://decision.vllm-sr.ai/docs'}}
+ assert.equal(billing.record(record).duplicate,false)
+ assert.equal(billing.record(record).duplicate,true)
+ assert.equal(billing.record(free).charge.amount,0)
+ assert.equal(ledger.days[localDayKey(at)].calls,2)
+ assert.equal(ledger.days[localDayKey(at)].sessions[0].id,sessionId)
+ assert.throws(()=>billing.record({...record,usage:{...usage,inputTokens:3}}),/identity conflict/)
+ const unknown={...base(),outcome:'failed',usage:null}
+ billing.record(unknown)
+ assert.equal(billing.read(sessionId).kinds.find(k=>k.kind==='jev-summary').missingUsage,1)
+ assert.equal(ledger.days[localDayKey(at)].calls,2,'missing usage does not invent zero token usage')
+ const cancelled={...base(),outcome:'cancelled'};billing.record(cancelled)
+ const rows=auxiliaryRecordsFor(path,sessionId,'')
+ assert.equal(rows.length,3);assert.equal(isAuxiliaryEvent({type:'cost-meter/auxiliary-usage',data:{}}),false)
+ const replay=replaySessionRecords([{type:'session',id:sessionId,createdAt:at-1000},...rows,...rows],config,null,true)
+ assert.equal(replay.samples.length,3,'journal duplicates are idempotent during replay')
+ near(replay.samples.reduce((n,r)=>n+r.cost,0),ledger.days[localDayKey(at)].cost)
+ const turn=turnCostFromRecords([{type:'session',id:sessionId,createdAt:at-1000},{type:'turn/start',seq:1,time:at-1,data:{turn:2}},{type:'turn/end',seq:2,time:at+1,data:{turn:2}}],config,1,2,rows)
+ assert.equal(turn.calls.length,3);assert.equal(turn.calls.filter(c=>c.kind==='jev-summary').length,2)
+ ledger.close()
+ const restarted=Ledger.load(path),again=createAuxiliaryBilling(restarted)
+ await again.recover();assert.equal(restarted.days[localDayKey(at)].calls,3)
+ assert.equal(again.record(record).duplicate,true)
+ // Crash after receipt append, before ledger write: recovery consumes it once.
+ const file=auxiliarySourcePath(path,sessionId),saved=readFileSync(file,'utf8').trim().split('\n').filter(Boolean).map(JSON.parse),late={...saved[0],requestId:randomUUID(),seq:saved.at(-1).seq+1,startedAtMs:at-1000}
+ writeFileSync(file,readFileSync(file,'utf8')+'\n'+JSON.stringify(late)+'\n')
+ await again.recover();await again.recover()
+ assert.equal(restarted.days[localDayKey(at)].calls,4,'arrival order rather than timestamp controls recovery')
+ const raw=JSON.stringify(again.read(sessionId));assert.ok(!raw.includes('Authorization')&&!raw.includes('observation'))
+ assert.throws(()=>again.record({...base(),provider:'other',pricing:free.pricing}),/Unsupported free/)
+ assert.throws(()=>again.record({...base(),usage:{...usage,inputTokens:-1}}),/Invalid auxiliary/)
+ restarted.resetHistory();again.record({...base(),startedAtMs:Date.now()})
+ await again.recover();assert.equal(again.read(sessionId).calls,1,'history reset never resurrects old receipts')
+ assert.equal(Object.values(restarted.days).reduce((n,d)=>n+d.calls,0),1)
+ restarted.close()
+ // Normal streams still bill while a marked auxiliary stream runs concurrently.
+ const accounts=[],listener=createLlmStreamBilling({account:(...args)=>accounts.push(args)})
+ let eager=false,lazy=false
+ const stream=()=>{eager=isAuxiliaryBilling();return listener({model:'deepseek-flash',sessionId},async function*(){lazy=isAuxiliaryBilling();await Promise.resolve();yield {type:'usage',usage}})}
+ await Promise.all([(async()=>{for await(const _ of withAuxiliaryBilling(stream)){} assert.equal(isAuxiliaryBilling(),false)})(),(async()=>{for await(const _ of listener({model:'normal'},async function*(){yield {type:'usage',usage}})){} })()])
+ assert.equal(eager,true);assert.equal(lazy,true);assert.equal(accounts.length,1);assert.equal(accounts[0][1],'normal')
+ console.log('[ok] JeV/summary durable receipts, replay, turn costs, reset and concurrent billing isolation')
+}finally{assert.ok(root.startsWith(join(tmpdir(),'cm-jev-')));rmSync(root,{recursive:true,force:true})}
