@@ -0,0 +1,165 @@
+/** Auxiliary plugin calls: durable, idempotent receipts, outside the model context. */
+import { AsyncLocalStorage } from 'node:async_hooks'
+import { createHash } from 'node:crypto'
+import { mkdirSync, lstatSync, readFileSync, appendFileSync, readdirSync, openSync, readSync, closeSync } from 'node:fs'
+import { join } from 'node:path'
+import { withLedgerLock } from './ledger-persistence.js'
+import { pricingConfigAt } from './billing-history.js'
+import { providerPriceEntryFor, costOf, usdFromCost } from './pricing.js'
+import { fxRatesOf } from './exchange-rates.js'
+
+export const AUXILIARY_EVENT = 'cost-meter/auxiliary-usage'
+const SOURCE = 'f24fcf8d-0418-45bc-91cd-3808db831246'
+const local = new AsyncLocalStorage()
+const cache = new Map()
+const rowIndexes = new WeakMap()
+const indexRows = rows => { const index = new Map(rows.map(row => [row.requestId,row]));rowIndexes.set(rows,index);return rows }
+const chargeValid = charge => charge === null || (charge && ['free','catalog'].includes(charge.kind) && charge.currency === 'USD' && Number.isFinite(charge.amount) && charge.amount >= 0)
+const digest = text => createHash('sha256').update(text).digest('hex')
+const id = value => typeof value === 'string' && value.length > 0 && value.length <= 512
+const tokenKeys = ['inputTokens','outputTokens','cacheReadTokens','cacheWriteTokens','reasoningTokens']
+const count = n => Number.isSafeInteger(n) && n >= 0
+const uuid = value => typeof value === 'string' && /^[a-f\d]{8}(?:-[a-f\d]{4}){3}-[a-f\d]{12}$/i.test(value)
+export const auxiliaryHistoryRoot = path => path + '.auxiliary'
+export const auxiliarySourcePath = (path, sessionId) => join(auxiliaryHistoryRoot(path), digest(sessionId) + '.jsonl')
+export const isAuxiliaryBilling = () => local.getStore() === true
+
+/** Covers eager stream creation, lazy dispatch, retries and iterator cleanup. */
+export function withAuxiliaryBilling(createStream) {
+  const stream = local.run(true, createStream)
+  return (async function* () {
+    const iterator = stream[Symbol.asyncIterator]()
+    let complete = false
+    try { for (;;) { const next = await local.run(true, () => iterator.next()); if(next.done){complete=true;break} yield next.value } }
+    finally { if(!complete) await local.run(true, () => iterator.return?.()) }
+  })()
+}
+export function freeAuxiliary(row) {
+  return row?.provider === 'jev' && row.model === 'vllm-sr/d3-turbo' && row.pricing?.kind === 'free'
+    && row.pricing.source === 'https://decision.vllm-sr.ai/docs'
+}
+export function normalizeAuxiliary(input) {
+  if(input?.protocol !== 1 || !uuid(input.requestId) || !id(input.sessionId)
+    || !/^[a-z][a-z0-9-]{0,79}$/.test(input.pluginId) || !/^[a-z][a-z0-9-]{0,79}$/.test(input.kind)
+    || !/^[\w./:@+-]{1,200}$/.test(input.provider) || !/^[\w./:@+-]{1,200}$/.test(input.model)
+    || !['ok','failed','cancelled'].includes(input.outcome) || !Number.isSafeInteger(input.startedAtMs) || input.startedAtMs <= 0
+    || input.startedAtMs > Date.now()+86400000 || !Number.isFinite(input.elapsedMs) || input.elapsedMs < 0
+    || !['free','catalog'].includes(input.pricing?.kind)) throw Error('Invalid auxiliary usage')
+  let usage = null
+  if(input.usage !== null) {
+    if(!count(input.usage?.inputTokens) || !count(input.usage?.outputTokens))throw Error('Invalid auxiliary tokens')
+    usage = Object.fromEntries(tokenKeys.map(key => [key,input.usage[key] ?? 0]))
+    if(!Object.values(usage).every(count))throw Error('Invalid auxiliary tokens')
+  }
+  const record = { protocol:1, requestId:input.requestId, sessionId:input.sessionId, pluginId:input.pluginId,
+    kind:input.kind, provider:input.provider, model:input.model, startedAtMs:input.startedAtMs,
+    elapsedMs:Math.trunc(input.elapsedMs), outcome:input.outcome, usage,
+    turn:count(input.turn)?input.turn:null,step:count(input.step)?input.step:null,
+    pricing:input.pricing.kind==='free'?{kind:'free',source:input.pricing.source}:{kind:'catalog'} }
+  if(record.pricing.kind === 'free' && !freeAuxiliary(record))throw Error('Unsupported free service')
+  return record
+}
+function readRows(path, sessionId) {
+  const file=auxiliarySourcePath(path,sessionId)
+  let info
+  try { info=lstatSync(file) }catch(error){if(error.code==='ENOENT')return [];throw error}
+  if(!info.isFile()||info.isSymbolicLink()||info.size>32*1024*1024)throw Error('Invalid auxiliary journal')
+  const prior=cache.get(file)
+  if(prior?.size===info.size&&prior.modified===info.mtimeMs)return prior.rows
+  const rows=[]
+  for(const line of readFileSync(file,'utf8').split('\n')) {
+    if(!line||line.length>4096)continue
+    try {const row=JSON.parse(line);normalizeAuxiliary(row)
+      if(row.sessionId===sessionId&&count(row.seq)&&row.seq>(rows.at(-1)?.seq??0)&&typeof row.resetId==='string'&&row.resetId.length<=200&&chargeValid(row.charge))rows.push({...normalizeAuxiliary(row),seq:row.seq,resetId:row.resetId,charge:row.charge})
+    }catch{}
+  }
+  indexRows(rows);cache.delete(file);cache.set(file,{size:info.size,modified:info.mtimeMs,rows})
+  while(cache.size>32)cache.delete(cache.keys().next().value)
+  return rows
+}
+export function auxiliaryRecordsFor(path,sessionId,resetId) {
+  if(!path||!id(sessionId))return []
+  return readRows(path,sessionId).filter(row=>(resetId===undefined||row.resetId===resetId)&&row.usage!==null)
+    .map(row=>({type:AUXILIARY_EVENT,time:row.startedAtMs,data:{...row}}))
+}
+export function listAuxiliarySessions(path) {
+  try {return readdirSync(auxiliaryHistoryRoot(path),{withFileTypes:true})
+    .filter(e=>e.isFile()&&/^[a-f\d]{64}\.jsonl$/.test(e.name)).slice(0,4096).flatMap(e=>{
+      const file=join(auxiliaryHistoryRoot(path),e.name),stat=lstatSync(file)
+      if(stat.size>32*1024*1024||stat.isSymbolicLink())return []
+      // Only the first small receipt is needed to recover the session identity.
+      const handle=openSync(file,'r');let first
+      try {const buffer=Buffer.alloc(8192),length=readSync(handle,buffer,0,buffer.length,0);first=buffer.toString('utf8',0,length).split('\n').find(line=>line.length>0)}finally{closeSync(handle)}
+      try {const row=JSON.parse(first);return id(row.sessionId)&&e.name===digest(row.sessionId)+'.jsonl'?[row.sessionId]:[]}catch{return []}
+    })}catch{return []}
+}
+export function isAuxiliaryEvent(event) {
+  if(event?.type!==AUXILIARY_EVENT||!event.data?.usage)return false
+  try {normalizeAuxiliary(event.data);return true}catch{return false}
+}
+
+function quote(ledger,row) {
+  if(freeAuxiliary(row))return {kind:'free',currency:'USD',amount:0,source:row.pricing.source}
+  if(!row.usage)return null
+  const config=pricingConfigAt(ledger.config,row.startedAtMs,row.sessionId,`${row.provider}:${row.model}`)
+  const resolved=providerPriceEntryFor(row.provider,row.model,config.prices,{mode:config.priceMatch==='exact'?'exact':'auto',overrides:config.priceOverrides})
+  if(!resolved.priced)return null
+  const usage=row.usage,tokens={input:usage.inputTokens,output:usage.outputTokens,cacheRead:usage.cacheReadTokens,cacheWrite:usage.cacheWriteTokens,reasoning:usage.reasoningTokens}
+  const peak={enabled:['deepseek-peak','utc-peak'].includes(resolved.billingMode)&&config.peakEnabled===true,
+    effectiveAtMs:Date.parse(config.peakEffectiveAt),windows:config.peakWindows,holidays:config.peakHolidays}
+  const amount=usdFromCost(costOf(tokens,resolved.entry,row.startedAtMs,peak),resolved.currency,fxRatesOf(config).CNY)
+  return {kind:'catalog',currency:'USD',amount,source:'dsh-cost-meter price catalog'}
+}
+export function createAuxiliaryBilling(ledger) {
+  const reset=()=>ledger.historyReset?.id??''
+  function reconcile(sessionId,rows) {
+    const source=SOURCE+':'+digest(sessionId+'|'+reset())
+    let low=0,high=rows.length;const cursor=ledger.usageCursors[source]??0
+    while(low<high){const mid=(low+high)>>>1;if(rows[mid].seq<=cursor)low=mid+1;else high=mid}
+    for(let i=low;i<rows.length;i++) {
+      const row=rows[i]
+      const meter={source,seq:row.seq}
+      if(row.resetId!==reset()||!row.usage||!row.charge){ledger.advanceUsageCursor(meter);continue}
+      const usage=row.usage
+      ledger.account({input:usage.inputTokens,output:usage.outputTokens,cacheRead:usage.cacheReadTokens,cacheWrite:usage.cacheWriteTokens,reasoning:usage.reasoningTokens},
+        row.model,row.sessionId,row.startedAtMs,row.provider,meter,undefined,freeAuxiliary(row))
+    }
+    ledger.flush()
+  }
+  return {
+    record(input) {
+      const value=normalizeAuxiliary(input)
+      ledger.refresh()
+      return withLedgerLock(auxiliaryHistoryRoot(ledger.path),()=>{
+        const root=auxiliaryHistoryRoot(ledger.path);mkdirSync(root,{recursive:true,mode:0o700})
+        if(lstatSync(root).isSymbolicLink())throw Error('Invalid auxiliary directory')
+        let rows=readRows(ledger.path,value.sessionId)
+        if(!rowIndexes.has(rows))indexRows(rows)
+        let row=rowIndexes.get(rows).get(value.requestId)
+        const duplicate=!!row
+        if(row && JSON.stringify(normalizeAuxiliary(row))!==JSON.stringify(value))throw Error('Auxiliary request identity conflict')
+        if(!row) {
+          row={...value,seq:(rows.at(-1)?.seq??0)+1,resetId:reset(),charge:quote(ledger,value)}
+          appendFileSync(auxiliarySourcePath(ledger.path,value.sessionId),'\n'+JSON.stringify(row)+'\n',{mode:0o600,flush:true})
+          const file=auxiliarySourcePath(ledger.path,value.sessionId),stat=lstatSync(file)
+          rows.push(row);rowIndexes.get(rows).set(row.requestId,row);cache.set(file,{size:stat.size,modified:stat.mtimeMs,rows})
+        }
+        reconcile(value.sessionId,rows)
+        return {accepted:true,duplicate,requestId:row.requestId,charge:row.charge}
+      },250)
+    },
+    read(sessionId) {
+      const rows=readRows(ledger.path,sessionId).filter(row=>row.resetId===reset())
+      const kinds=Object.create(null)
+      for(const row of rows) {
+        const group=kinds[row.kind]??={kind:row.kind,calls:0,successful:0,failed:0,cancelled:0,missingUsage:0,unpriced:0,inputTokens:0,outputTokens:0,cacheReadTokens:0,cacheWriteTokens:0,costUsd:0}
+        group.calls++;group[row.outcome==='ok'?'successful':row.outcome]++
+        if(row.usage)for(const key of tokenKeys.filter(k=>k!=='reasoningTokens'))group[key]+=row.usage[key]
+        else group.missingUsage++
+        if(row.charge)group.costUsd+=row.charge.amount;else group.unpriced++
+      }
+      return {protocol:1,calls:rows.length,kinds:Object.values(kinds),records:rows.slice(-100)}
+    },
+    async recover(){for(const sessionId of listAuxiliarySessions(ledger.path)){ledger.refresh();reconcile(sessionId,readRows(ledger.path,sessionId));await new Promise(resolve=>setImmediate(resolve))}},
+  }
+}
