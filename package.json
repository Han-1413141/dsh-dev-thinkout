{
  "name": "dsh-jev-progress",
  "version": "0.5.5",
  "type": "module",
  "description": "JeV 思维链外显：将 DeepSeek 的任务规划、进度与阶段小结呈现为聊天正文，支持轻量摘要、原生翻译及父子任务流程图，不改主模型上下文",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./hidden": "./src/host-hidden.js",
    "./core": "./src/core/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-client.mjs",
    "check:release": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {},
  "files": [
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party/DeepSeek-Harness-LICENSE",
    "presets",
    "docs/user-guide.md",
    "docs/architecture.md",
    "docs/development.md",
    "docs/images/jev-thinkout-progress.png",
    "docs/images/dsh-native-response.png",
    "integrations/dsh-cost-meter/README.md",
    "integrations/dsh-cost-meter/auxiliary-billing.patch"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Han-1413141/dsh-jev-thinkout.git"
  },
  "homepage": "https://github.com/Han-1413141/dsh-jev-thinkout#readme",
  "bugs": {
    "url": "https://github.com/Han-1413141/dsh-jev-thinkout/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "jev",
    "progress",
    "workflow",
    "thinkout",
    "reasoning-summary"
  ],
  "author": "Han-1413141",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
